"hartChart.saccades.colorModes.title" = "4 Hoeken Kleur — Drie oproepmodi";
"hartChart.saccades.colorModes.intro" = "Gebruik de 4-Hoeken-Kleurgrafiek op de muur. Wanneer u een saccade naar elk doel maakt, roept u hardop:";
"hartChart.saccades.colorModes.colorOnly" = "**Alleen kleur** — zeg de kleur van de letter (bijv. \"Rood\", \"Blauw\")";
