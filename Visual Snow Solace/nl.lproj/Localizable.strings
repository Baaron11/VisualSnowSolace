"hartChart.stop" = "Stop";
"hartChart.start.accessibility" = "Sessie starten";
"hartChart.stop.accessibility" = "Sessie stoppen";
"hartChart.info.accessibility" = "Hoe deze oefening te doen";
"hartChart.info.warning" = "Beweeg uw hoofd niet tijdens deze oefening — beweeg alleen uw ogen.";
"hartchart.info.standard.title" = "Standaard Hart-grafiek";
"hartchart.info.fourcornerBW.title" = "4 Hoeken Z/W";
"hartchart.info.fourcornerColor.title" = "4 Hoeken Kleur";
"hartchart.info.standard.body" = "Stel het metronoom in op 60 BPM om te beginnen.\n\nPlaats deze grafiek op een muur op afstand. Bedek één oog met een patch of uw hand.\n\nBeginnend bij de bovenste rij:\n• Bij de eerste slag — zeg de meest linkse letter hardop\n• Bij de volgende slag — zeg de meest rechtse letter hardop\n• Dan de tweede van links, dan de tweede van rechts\n• Ga verder naar binnen totdat u het midden van de rij bereikt\n• Ga naar de volgende rij en herhaal\n\nEén letter per slag. Zeg elke letter hardop wanneer uw ogen erop landen.\n\nDoe dit 2 minuten met één oog bedekt, wissel dan naar het andere oog voor nog 2 minuten. U kunt het ook met beide ogen open doen.";
"hartchart.info.fourcornerBW.body" = "Stel het metronoom in op 60 BPM om te beginnen.\n\nPlaats deze grafiek op een muur op afstand. Houd beide ogen open.\n\nVolg een S-beweging — geen cirkel — door de vier hoekgrafieken:\n1. Eerste letter, linksboven grafiek\n2. Eerste letter, rechtsboven grafiek\n3. Eerste letter, linksonder grafiek\n4. Eerste letter, rechtsonder grafiek\n\nGa dan naar de tweede letter in elke grafiek, volg dezelfde S-beweging. Ga 2 minuten door.\n\nEén letter per slag. Zeg elke letter hardop wanneer u erop landt. Beweeg uw hoofd niet — alleen de ogen.";
"hartchart.info.fourcornerColor.body" = "Stel het metronoom in op 60 BPM om te beginnen.\n\nPlaats deze grafiek op een muur op afstand. Houd beide ogen open.\n\nVolg dezelfde S-beweging als de Z/W-grafiek:\n1. Linksboven grafiek → rechtsboven grafiek → linksonder grafiek → rechtsonder grafiek\n2. Ga dan naar de volgende letter in elke grafiek en herhaal\n\nWissel af wat u bij elke slag zegt:\n• Eerste doel — zeg de letter of het getal hardop\n• Volgende doel — zeg de kleur ervan hardop\n• Blijf afwisselen: letter, kleur, letter, kleur…\n\nBeweeg uw hoofd niet — alleen de ogen.";

