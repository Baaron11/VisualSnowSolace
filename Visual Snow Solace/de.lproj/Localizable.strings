"hartChart.saccades.alternating.title" = "Standard — Abwechselnd (1–10, 2–9…)";
"hartChart.saccades.alternating.body" = "Beginnen Sie bei 1 links, dann springen Sie zu 10 rechts. Dann 2, dann 9. Dann 3, dann 8 — weiter nach innen bis zur Mitte. Dies trainiert Sakkaden mit größerer Amplitude und symmetrische Augenbewegung. Sagen Sie jede Zahl oder jeden Buchstaben laut, wenn Sie darauf landen.";
"hartChart.saccades.colorModes.title" = "4 Ecken Farbe — Drei Aufrufmodi";
"hartChart.saccades.colorModes.intro" = "Verwenden Sie die 4-Ecken-Farbtabelle an der Wand. Wenn Sie eine Sakkade zu jedem Ziel machen, rufen Sie laut:";
"hartChart.saccades.colorModes.colorOnly" = "**Nur Farbe** — sagen Sie die Farbe des Buchstabens (z.B. \"Rot\", \"Blau\")";
