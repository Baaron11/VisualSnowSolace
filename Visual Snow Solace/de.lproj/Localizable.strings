"hartChart.start" = "Start";
"hartChart.stop" = "Stopp";
"hartChart.start.accessibility" = "Sitzung starten";
"hartChart.stop.accessibility" = "Sitzung stoppen";
"hartChart.info.accessibility" = "So führen Sie diese Übung durch";
"hartChart.info.warning" = "Bewegen Sie den Kopf während dieser Übung nicht — bewegen Sie nur die Augen.";
"hartchart.info.standard.title" = "Standard Hart-Tabelle";
"hartchart.info.fourcornerBW.title" = "4 Ecken S/W";
"hartchart.info.fourcornerColor.title" = "4 Ecken Farbe";
"hartchart.info.standard.body" = "Stellen Sie das Metronom auf 60 BPM, um zu beginnen.\n\nPlatzieren Sie diese Tabelle auf einer Wand in der Ferne. Bedecken Sie ein Auge mit einer Augenklappe oder Ihrer Hand.\n\nBeginnend von der obersten Zeile:\n• Beim ersten Schlag — sagen Sie den am weitesten links stehenden Buchstaben laut\n• Beim nächsten Schlag — sagen Sie den am weitesten rechts stehenden Buchstaben laut\n• Dann den zweiten von links, dann den zweiten von rechts\n• Weiter nach innen bis zur Mitte der Zeile\n• Zur nächsten Zeile wechseln und wiederholen\n\nEin Buchstabe pro Schlag. Sagen Sie jeden Buchstaben laut, wenn die Augen darauf landen.\n\nTun Sie dies 2 Minuten mit einem bedeckten Auge, dann wechseln Sie zum anderen Auge für weitere 2 Minuten. Sie können es auch mit beiden Augen offen machen.";
"hartchart.info.fourcornerBW.body" = "Stellen Sie das Metronom auf 60 BPM, um zu beginnen.\n\nPlatzieren Sie diese Tabelle auf einer Wand in der Ferne. Halten Sie beide Augen offen.\n\nFolgen Sie einer S-Bewegung — nicht einem Kreis — durch die vier Ecktabellen:\n1. Erster Buchstabe, obere linke Tabelle\n2. Erster Buchstabe, obere rechte Tabelle\n3. Erster Buchstabe, untere linke Tabelle\n4. Erster Buchstabe, untere rechte Tabelle\n\nGehen Sie dann zum zweiten Buchstaben in jeder Tabelle über, folgen Sie dabei derselben S-Bewegung. Fahren Sie 2 Minuten fort.\n\nEin Buchstabe pro Schlag. Sagen Sie jeden Buchstaben laut, wenn Sie darauf landen. Bewegen Sie nicht den Kopf — nur die Augen.";
"hartchart.info.fourcornerColor.body" = "Stellen Sie das Metronom auf 60 BPM, um zu beginnen.\n\nPlatzieren Sie diese Tabelle auf einer Wand in der Ferne. Halten Sie beide Augen offen.\n\nFolgen Sie derselben S-Bewegung wie bei der S/W-Tabelle:\n1. Obere linke Tabelle → obere rechte Tabelle → untere linke Tabelle → untere rechte Tabelle\n2. Dann zum nächsten Buchstaben in jeder Tabelle wechseln und wiederholen\n\nWechseln Sie ab, was Sie bei jedem Schlag sagen:\n• Erstes Ziel — sagen Sie den Buchstaben oder die Zahl laut\n• Nächstes Ziel — sagen Sie seine Farbe laut\n• Weiter abwechseln: Buchstabe, Farbe, Buchstabe, Farbe…\n\nBewegen Sie nicht den Kopf — nur die Augen.";

