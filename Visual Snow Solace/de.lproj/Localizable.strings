/* ── LifesaverView ── */
"lifesaver.title" = "Rettungsring";
"lifesaver.cardRequired.title" = "Rettungsring-Karte erforderlich";
"lifesaver.cardRequired.description" = "Suchen Sie nach \"Sehtherapie-Rettungsring-Karte\", um transparente oder gedruckte Karten für diese Übung zu finden.";
"lifesaver.instructions.title" = "So verwenden Sie Rettungsring-Karten";
"lifesaver.instructions.body" = "Rettungsring-Karten sind kleine transparente Karten (oder auf weißem Papier gedruckt) mit zwei identischen Ring- oder Kreismustern nebeneinander. Sie können sie von einem Sehtherapeuten erhalten oder eine Standardvorlage ausdrucken.\n\nHalten Sie die Karte auf Armlänge. Lassen Sie Ihre Augen langsam entspannen und divergieren — als ob Sie durch die Karte auf etwas weit Entferntes schauen würden. Ein dritter Ring sollte in der Mitte zwischen den beiden gedruckten Ringen zu erscheinen scheinen. Dies ist das fusionierte Bild.\n\nSobald Sie den dritten Ring sehen, versuchen Sie, ihn klar zu fokussieren und 5–10 Sekunden zu halten. Nähern Sie die Karte schrittweise, während Sie sich verbessern. Hören Sie sofort auf, wenn Sie Augenbelastung, Kopfschmerzen oder Beschwerden verspüren.";
